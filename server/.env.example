# Same cluster/DB as the Student Portal
MONGO_URI=

JWT_SECRET=
JWT_EXPIRES_IN=8h
PORT=5020
# Comma-separate production origins when needed. Both local Vite ports are accepted in development.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Result publication mailer (SMTP). Use a transactional mail provider in production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer-user
SMTP_PASS=mailer-password
EMAIL_FROM=ExamPlat Results <results@example.com>

# Shipped Super Admin (used only by seed.js, first-run)
SUPERADMIN_EMAIL=super.admin@examplat.com
SUPERADMIN_PASSWORD=superAdmin@123

